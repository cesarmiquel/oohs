    46 00000016 88F0                      mov al, dh         ; 2 bytes
    47 00000018 3CA1                      cmp al, 64+32*3+1
    48 0000001A 7776                      ja blit
    49 0000001C C0C003                    rol al, 3          ; 3 bytes  40h->02h, 60h->03h, 80h->04h
    50 0000001F 2C02                      sub al, 2          ; 2 bytes  -> 0, 1, 2
    51 00000021 3C02                      cmp al, 2          ; 2 bytes
    52 00000023 760F                      jbe draw           ; 2 bytes  unsigned: AL <= 2
    53                                  
    54 00000025 89FE                      mov si, di
    55 00000027 81EE4001                  sub si, 320
    56 0000002B B94001                    mov cx, 320
    57 0000002E FC                        cld
    58 0000002F 26F3A4                    es rep movsb
    59 00000032 EBD8                      jmp short top
    60                                  
    61                                  draw:
    62 00000034 C0EE05                    shr dh, 5 ; row - y/32
    63 00000037 80EE02                    sub dh, 2 ; row - 2
    64                                  
    65                                    ; 0 <= row < 3
    66 0000003A 7C56                      jl blit
    67 0000003C 80FE02                    cmp dh, 2
    68 0000003F 7F51                      jg blit
    69                                  
