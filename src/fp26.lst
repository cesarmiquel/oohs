     1                                  org 0x100
     2                                  
     3                                  ; %define tempo 30
     4                                  x2        equ   0x900
     5                                  initial_time    equ 260
     6                                  
     7                                  init:
     8                                  
     9                                    ; setup gfx
    10 00000000 B013                    	mov al, 0x13
    11 00000002 CD10                    	int 0x10
    12 00000004 95                      	xchg bp, ax
    13 00000005 6800A0                  	push 0xa000
    14 00000008 07                      	pop es
    15                                  
    16                                    ; setup dos timer
    17                                    ;mov ax, 0x251c
    18                                  	;mov dx, timer
    19                                  	;int 0x21
    20                                  
    21                                    ; DELETE mov bp, initial_time
    22                                  
    23                                  top:
    24 00000009 B8CDCC                  	mov ax, 0xcccd
    25 0000000C F7E7                    	mul di  ; dh: y coord, dl: x coord + carry
    26                                  
    27                                    ;cmp dh, 64
    28                                    ;je draw
    29                                    ;cmp dh, 64+32
    30                                    ;je draw
    31                                    ;cmp dh, 64+32*2
    32                                    ;je draw
    33                                    ;cmp dh, 64+32*3+1
    34                                    ;ja blit2
    35                                  
    36                                    ; draw only lines in 0x40, 0x60, 0x80
    37 0000000E 88F0                      mov al, dh         ; 2 bytes
    38 00000010 3CA1                      cmp al, 64+32*3+1
    39 00000012 7754                      ja blit
    40 00000014 C0C003                    rol al, 3          ; 3 bytes  40h->02h, 60h->03h, 80h->04h
    41 00000017 2C02                      sub al, 2          ; 2 bytes  -> 0, 1, 2
    42 00000019 3C02                      cmp al, 2          ; 2 bytes
    43 0000001B 760C                      jbe draw           ; 2 bytes  unsigned: AL <= 2
    44                                  
    45 0000001D 8DB5C0FE                  lea si, [di-320]
    46 00000021 B94001                    mov cx, 320
    47 00000024 26F3A4                    es rep movsb
    48 00000027 EBE0                      jmp short top
    49                                  
    50                                  draw:
    51 00000029 88C6                      mov dh, al
    52                                  
    53                                    ; load si with pointer to font row
    54                                    ;mov si, fptext
    55 0000002B B400                      mov ah, 0
    56 0000002D 69C00600                  mul ax, 6   ; row * 6
    57 00000031 89C6                      mov si, ax
    58                                  
    59                                    ; save x and init x2
    60 00000033 88D0                      mov al, dl
    61 00000035 3480                      xor al, 0x80
    62 00000037 98                        cbw ; convert 8-bit negative to 16-bit negative (ax)
    63 00000038 A30009                    mov word [x2], ax
    64 0000003B C0F803                    sar al, 3  ; shift right and preserve sign
    65                                  
    66 0000003E BA0100                    mov dx, 1   ; dl loop counter, dh = 0 (idx)
    67 00000041 88C5                      mov ch, al  ; x/8
    68                                  
    69                                  loop:
    70 00000043 A10009                    mov ax, word [x2]
    71 00000046 29E8                      sub ax, bp
    72                                    ;sub ax, -80
    73 00000048 7C10                      jl .skip
    74                                  
    75 0000004A C1E805                    shr ax, 5  ; ofx = (x2-x1)/32
    76 0000004D 3C2F                      cmp al, 47
    77 0000004F 7F79                      jg restart
    78                                  
    79                                    ;xor ah, ah
    80 00000051 0FA384[E000]              bt [si+fptext], ax
    81 00000056 7302                      jnc .skip
    82                                  
    83 00000058 08D6                      or dh, dl
    84                                  
    85                                  .skip:
    86 0000005A 88E8                      mov al, ch
    87 0000005C 98                        cbw
    88 0000005D 01060009                  add word [x2], ax
    89                                  
    90 00000061 D0E2                      shl dl, 1
    91 00000063 80FA10                    cmp dl, 0x10
    92 00000066 75DB                      jne loop
    93                                  
    94                                  blit:
    95 00000068 BB[D000]                  mov bx, palette
    96 0000006B 88F0                      mov al, dh
    97 0000006D D7                        xlat
    98 0000006E AA                      	stosb
    99                                  
   100 0000006F 85FF                      test di, di
   101 00000071 7596                      jnz top
   102                                  
   103                                  ; - stabilizes image a bit
   104 00000073 BADA03                    mov dx, 3DAh
   105                                  .wait_start:
   106 00000076 EC                        in al, dx
   107 00000077 A808                      test al, 8
   108 00000079 74FB                      jz .wait_start     ; wait for new retrace to begin
   109                                  
   110 0000007B 4D                        dec bp
   111                                  
   112                                  %ifdef MUSIC
   113                                    ; Music
   114 0000007C BE[F200]                  mov si, music
   115 0000007F F7C50700                  test bp, 0x07
   116 00000083 7533                      jnz skip_play
   117                                  
   118                                  ch1:
   119                                    ; silence ch1 and set fixed volume for ch2
   120 00000085 C6440700                  mov byte [si + 2 + 5], 0      ; ch1
   121 00000089 C6440A5A                  mov byte [si + 5 + 5], 90     ; ch2
   122                                  
   123                                    ; pattern 1
   124 0000008D D0440B                    rol byte [si + 6 + 5], 1
   125 00000090 7208                      jc skipmute1
   126                                  
   127                                    ; mute ch1
   128 00000092 C6440700                  mov byte [si + 2 + 5], 0
   129                                  
   130                                    ; use pattern 1 to gate the synth channel (ch0)
   131 00000096 8074047F                  xor byte [si + 4], 0x7f
   132                                  
   133                                  skipmute1:
   134 0000009A D0440C                    rol byte [si + 7 + 5], 1
   135 0000009D 7204                      jc skipmute2
   136                                  
   137                                    ; mute ch 2
   138 0000009F C6440A00                  mov byte [si + 5 + 5], 0
   139                                  
   140                                  skipmute2:
   141                                    ; switches instruments of ch1 and ch2
   142 000000A3 80740601                  xor byte [si + 1 + 5], 1
   143 000000A7 80740901                  xor byte [si + 4 + 5], 1
   144                                  
   145                                  playmidi:
   146 000000AB BA3003                    mov dx, 0x330
   147 000000AE B10B                      mov cl, 6 + 5
   148 000000B0 F36E                      rep  outsb
   149 000000B2 42                        inc dx
   150 000000B3 6E                        outsb
   151                                  
   152                                    ; increase volume of ch1
   153                                  incvol:
   154 000000B4 FE06[8800]                inc [ch1+3]
   155                                  %endif
   156                                  
   157                                  skip_play:
   158 000000B8 81FD90FD                  cmp bp, 0xfd90
   159 000000BC 7F0C                      jg .skip
   160 000000BE C6440339                  mov [si+3], 57
   161                                  
   162 000000C2 81FDB0F9                  cmp bp, 0xf9b0
   163 000000C6 7F02                      jg .skip
   164                                  
   165 000000C8 EB05                      jmp short quit
   166                                    ;mov bp, initial_time ; reset timer to repeat
   167                                  
   168                                  .skip:
   169                                  
   170                                    ;mov al, tempo
   171                                  	;out 40h, al
   172                                  	;in al, 0x60
   173                                  	;dec al
   174                                  	;jmp top
   175                                  
   176                                    ; wait for ESC
   177                                    ;in ax, 0x60
   178                                    ;dec al
   179                                  ;jnz restart
   180                                  
   181                                  restart:
   182 000000CA 47                        inc di
   183 000000CB 0F853AFF                  jne top
   184                                  
   185                                  quit:
   186 000000CF C3                        ret
