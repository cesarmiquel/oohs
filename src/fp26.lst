   189                                  skip_play:
   190 000000E0 61                        popa
   191 000000E1 CF                        iret
   192                                  
   193                                  palette:
   194                                    ;db 0, 124, 2, 50
   195                                    ;db 4, 25, 116, 71
   196                                    ;db 34, 79, 79, 76
   197                                    ;db 36, 60, 84, 15
   198                                  
   199 000000E2 00                        db 0
   200 000000E3 03                        db 3   ; l0
   201 000000E4 7C                        db 124 ; l1
   202 000000E5 34                        db 52  ; l0+l1
   203                                  
   204 000000E6 04                        db 4   ; l2
   205 000000E7 34                        db 52  ; l0+l2
   206 000000E8 1B                        db 27  ; l1+l2
   207 000000E9 64                        db 100 ; l0+l1+l2
   208                                  
   209 000000EA 6C                        db 108 ; l3
   210 000000EB 38                        db 56  ; l0+l3
   211 000000EC 4F                        db 79  ; l1+l3
   212 000000ED 4C                        db 76 ; l0+l1+l3
   213                                  
   214 000000EE 26                        db 38  ; l2+l3
   215 000000EF 3C                        db 60  ; l0+l2+l3
   216 000000F0 54                        db 84  ; l1+l2+l3
   217 000000F1 0F                        db 15  ; l0+l1+l2+l3
