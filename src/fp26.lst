     1                                  org 0x100
     2                                  
     3                                  %define tempo 30
     4                                  
     5                                  x2        equ   0x900
     6                                  incx      equ   0x902
     7                                  count     equ   0x903
     8                                  
     9                                  initial_time    equ 0xffc0
    10                                  final_time      equ 0x86
    11                                  
    12                                  init:
    13                                  
    14                                    ; setup gfx
    15 00000000 B013                    	mov al, 0x13
    16 00000002 CD10                    	int 0x10
    17 00000004 95                      	xchg bp, ax
    18 00000005 68F69F                  	push 0xa000-10
    19 00000008 07                      	pop es
    20                                  
    21                                    ; setup dos timer
    22 00000009 B81C25                    mov ax, 0x251c
    23 0000000C BA[A800]                	mov dx, timer
    24 0000000F CD21                    	int 0x21
    25                                  
    26                                  top:
    27 00000011 B8CDCC                  	mov ax, 0xcccd
    28 00000014 F7E7                    	mul di  ; dh: y coord, dl: x coord + carry
    29                                  
    30 00000016 C606[8C00]00              mov byte [palidx+2], 0
    31                                  
    32                                  ;  cmp dh, 64
    33                                  ;  je draw
    34                                  ;
    35                                  ;  mov si, di
    36                                  ;  sub si, 320*1
    37                                  ;  mov al, byte [si]
    38                                  ;  jmp blit2
    39                                  
    40                                  draw:
    41 0000001B C0EE05                    shr dh, 5 ; row - y/32
    42 0000001E 80EE02                    sub dh, 2 ; row - 2
    43                                  
    44                                    ; 0 <= row < 3
    45 00000021 7C64                      jl blit
    46 00000023 80FE02                    cmp dh, 2
    47 00000026 7F5F                      jg blit
    48                                  
    49                                    ; load si with pointer to font row
    50 00000028 BE[B900]                  mov si, fptext
    51 0000002B 31C0                      xor ax, ax
    52 0000002D 88F0                      mov al, dh
    53 0000002F 69C00600                  mul ax, 6   ; row * 6
    54 00000033 01C6                      add si, ax
    55                                  
    56                                    ; save x and init x2
    57 00000035 88D0                      mov al, dl
    58 00000037 98                        cbw ; convert 8-bit negative to 16-bit negative (ax)
    59 00000038 A30009                    mov word [x2], ax
    60 0000003B C0FA03                    sar dl, 3  ; shift right and preserve sign
    61 0000003E 88160209                  mov byte [incx], dl
    62 00000042 C606030901                mov byte [count], 1
    63                                  
    64                                  loop:
    65 00000047 A10009                    mov ax, word [x2]
    66 0000004A 89EA                      mov dx, bp
    67 0000004C 29D0                      sub ax, dx
    68 0000004E 3D0000                    cmp ax, 0
    69                                  
    70 00000051 7C21                      jl skip
    71                                  
    72 00000053 C1E805                    shr ax, 5  ; ofx = (x2-x1)/32
    73 00000056 50                        push ax
    74 00000057 C1E803                    shr ax, 3  ; pos = ofx/8
    75 0000005A 3C05                      cmp al, 5
    76 0000005C 7F29                      jg  blit
    77                                  
    78 0000005E 93                        xchg bx, ax
    79                                  
    80 0000005F 30E4                      xor ah, ah
    81 00000061 8A00                      mov al, byte [si+bx]
    82 00000063 59                        pop cx
    83 00000064 81E10700                  and cx, 0x0007
    84 00000068 D2E0                      shl al, cl
    85 0000006A 7308                      jnc skip
    86                                  
    87 0000006C 8A0E0309                  mov cl, byte [count]
    88 00000070 080E[8C00]                or byte [palidx+2], cl
    89                                  
    90                                  skip:
    91 00000074 A00209                    mov al, byte [incx]
    92 00000077 98                        cbw
    93 00000078 01060009                  add word [x2], ax
    94                                  
    95 0000007C D0260309                  shl [count], 1
    96 00000080 803E030910                cmp [count], 0x10
    97 00000085 75C0                      jne loop
    98                                  
    99                                  blit:
   100 00000087 BE[A900]                  mov si, palette
   101                                  palidx:
   102 0000008A 83C602                    add si, byte 0x2
   103 0000008D AC                        lodsb
   104                                  blit2:
   105 0000008E AA                      	stosb
   106 0000008F 47                      	inc di
   107 00000090 47                      	inc di
   108 00000091 0F857CFF                  jnz top
   109 00000095 4D                        dec bp
   110 00000096 4D                        dec bp
   111 00000097 4D                        dec bp
   112 00000098 0F8575FF                  jnz top
   113 0000009C B01E                      mov al, tempo
   114 0000009E E640                    	out 40h, al
   115 000000A0 E460                    	in al, 0x60
   116 000000A2 FEC8                    	dec al
   117 000000A4 0F8569FF                	jnz top
