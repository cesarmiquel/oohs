    79 00000050 3480                      xor al, 0x80
    80 00000052 98                        cbw ; convert 8-bit negative to 16-bit negative (ax)
    81 00000053 A30009                    mov word [x2], ax
    82 00000056 C0F803                    sar al, 3  ; shift right and preserve sign
    83 00000059 A20209                    mov byte [incx], al
    84                                  
    85 0000005C B201                      mov dl, 1
    86                                  
