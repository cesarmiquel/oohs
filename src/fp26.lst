   213                                    ;db 0xca  ; change instrument on channel 3
   214                                    ;db 39    ; Instrument: https://en.wikipedia.org/wiki/General_MIDI#Sound_Effects
   215 000000FD 99                        db 0x99  ; play note on channel 10
   216 000000FE 23                        db 35    ; deep "b" = note number 35
   217 000000FF 7F                        db 127    ; play with volume = 127
   218                                    ;db 43    ; play with volume = 127
