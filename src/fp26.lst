     1                                  org 0x100
     2                                  
     3                                  %define tempo 90
     4                                  
     5                                  x2        equ   0x900
     6                                  incx      equ   0x902
     7                                  idx       equ   0x904
     8                                  
     9                                  initial_time    equ 260
    10                                  
    11                                  init:
    12                                  
    13                                    ; setup gfx
    14 00000000 B013                    	mov al, 0x13
    15 00000002 CD10                    	int 0x10
    16 00000004 95                      	xchg bp, ax
    17 00000005 6800A0                  	push 0xa000
    18 00000008 07                      	pop es
    19                                  
    20                                    ; setup dos timer
    21 00000009 B81C25                    mov ax, 0x251c
    22 0000000C BA[C700]                	mov dx, timer
    23 0000000F CD21                    	int 0x21
    24                                  
    25                                    ; DELETE mov bp, initial_time
    26                                  
    27                                  top:
    28 00000011 B8CDCC                  	mov ax, 0xcccd
    29 00000014 F7E7                    	mul di  ; dh: y coord, dl: x coord + carry
    30                                  
    31 00000016 C606040900                mov byte [idx], 0
    32                                  
    33                                    ;cmp dh, 64
    34                                    ;je draw
    35                                    ;cmp dh, 64+32
    36                                    ;je draw
    37                                    ;cmp dh, 64+32*2
    38                                    ;je draw
    39                                    ;cmp dh, 64+32*3+1
    40                                    ;ja blit2
    41                                  
    42                                    ; draw only lines in 0x40, 0x60, 0x80
    43 0000001B 88F0                      mov al, dh         ; 2 bytes
    44 0000001D 3CA1                      cmp al, 64+32*3+1
    45 0000001F 7776                      ja blit
    46 00000021 C0C003                    rol al, 3          ; 3 bytes  40h->02h, 60h->03h, 80h->04h
    47 00000024 2C02                      sub al, 2          ; 2 bytes  -> 0, 1, 2
    48 00000026 3C02                      cmp al, 2          ; 2 bytes
    49 00000028 760F                      jbe draw           ; 2 bytes  unsigned: AL <= 2
    50                                  
    51 0000002A 89FE                      mov si, di
    52 0000002C 81EE4001                  sub si, 320
    53 00000030 B94001                    mov cx, 320
    54 00000033 FC                        cld
    55 00000034 26F3A4                    es rep movsb
    56 00000037 EBD8                      jmp short top
    57                                  
    58                                  draw:
    59 00000039 C0EE05                    shr dh, 5 ; row - y/32
    60 0000003C 80EE02                    sub dh, 2 ; row - 2
    61                                  
    62                                    ; 0 <= row < 3
    63 0000003F 7C56                      jl blit
    64 00000041 80FE02                    cmp dh, 2
    65 00000044 7F51                      jg blit
    66                                  
    67                                    ; load si with pointer to font row
    68 00000046 BE[F200]                  mov si, fptext
    69 00000049 31C0                      xor ax, ax
    70 0000004B 88F0                      mov al, dh
    71 0000004D 69C00600                  mul ax, 6   ; row * 6
    72 00000051 01C6                      add si, ax
    73                                  
    74                                    ; save x and init x2
    75 00000053 88D0                      mov al, dl
    76 00000055 3480                      xor al, 0x80
    77 00000057 98                        cbw ; convert 8-bit negative to 16-bit negative (ax)
    78 00000058 A30009                    mov word [x2], ax
    79 0000005B C0F803                    sar al, 3  ; shift right and preserve sign
    80 0000005E A20209                    mov byte [incx], al
    81                                  
    82 00000061 B201                      mov dl, 1
    83                                  
    84                                  loop:
    85 00000063 A10009                    mov ax, word [x2]
    86 00000066 29E8                      sub ax, bp
    87                                    ;sub ax, -80
    88 00000068 7C1E                      jl .skip
    89                                  
    90 0000006A C1E805                    shr ax, 5  ; ofx = (x2-x1)/32
    91 0000006D 89C1                      mov cx, ax
    92 0000006F C1E803                    shr ax, 3  ; pos = ofx/8
    93 00000072 3C05                      cmp al, 5
    94 00000074 7F4C                      jg restart
    95                                  
    96 00000076 93                        xchg bx, ax
    97                                  
    98 00000077 30E4                      xor ah, ah
    99 00000079 8A00                      mov al, byte [si+bx]
   100 0000007B 80E107                    and cl, 0x07
   101 0000007E D2E0                      shl al, cl
   102 00000080 7306                      jnc .skip
   103                                  
   104 00000082 88D1                      mov cl, dl
   105 00000084 080E0409                  or byte [idx], cl
   106                                  
   107                                  .skip:
   108 00000088 A00209                    mov al, byte [incx]
   109 0000008B 98                        cbw
   110 0000008C 01060009                  add word [x2], ax
   111                                  
   112 00000090 D0E2                      shl dl, 1
   113 00000092 80FA10                    cmp dl, 0x10
   114 00000095 75CC                      jne loop
   115                                  
   116                                  blit:
   117 00000097 BB[E200]                  mov bx, palette
   118 0000009A A00409                    mov al, byte [idx]
   119 0000009D D7                        xlat
   120 0000009E AA                      	stosb
   121                                  
   122                                  
   123                                    ; DELETE
   124                                  ;.loop:
   125                                  ;  cmp di, 64*320 + 320*20
   126                                  ;  jg .loop
   127                                  
   128                                  	;inc di
   129                                  	;inc di
   130 0000009F 85FF                      test di, di
   131 000000A1 0F856CFF                  jnz top
   132                                  
   133                                  ; - stabilizes image a bit
   134 000000A5 BADA03                    mov dx, 3DAh
   135                                  .wait_start:
   136 000000A8 EC                        in al, dx
   137 000000A9 A808                      test al, 8
   138 000000AB 74FB                      jz .wait_start     ; wait for new retrace to begin
   139                                  
   140                                  ;  dec bp
   141 000000AD 4D                        dec bp
   142                                  
   143 000000AE 81FD00F9                  cmp bp, 0xf900
   144 000000B2 7F03                      jg .skip
   145                                  
   146 000000B4 BD0401                    mov bp, initial_time
   147                                  
   148                                  .skip:
   149                                  
   150 000000B7 B05A                      mov al, tempo
   151 000000B9 E640                    	out 40h, al
   152 000000BB E460                    	in al, 0x60
   153 000000BD FEC8                    	dec al
   154 000000BF E94FFF                  	jmp top
   155                                  
   156                                  restart:
   157 000000C2 47                        inc di
   158 000000C3 0F854AFF                  jne top
   159                                  
   160                                  timer:
   161 000000C7 60                        pusha
   162                                  ;  dec bp
   163                                  ;
   164                                  ;  cmp bp, 0xf900
   165                                  ;  jg .skip
   166                                  ;
   167                                  ;  mov bp, initial_time
