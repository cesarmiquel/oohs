   196                                  palette:
   197                                    ;db 0, 124, 2, 50
   198                                    ;db 4, 25, 116, 71
   199                                    ;db 34, 79, 79, 76
   200                                    ;db 36, 60, 84, 15
   201                                  
   202 000000D3 00                        db 0
   203 000000D4 03                        db 3   ; l0
   204 000000D5 7C                        db 124 ; l1
   205 000000D6 34                        db 52  ; l0+l1
   206                                  
   207 000000D7 04                        db 4   ; l2
   208 000000D8 34                        db 52  ; l0+l2
   209 000000D9 1B                        db 27  ; l1+l2
   210 000000DA 64                        db 100 ; l0+l1+l2
   211                                  
   212 000000DB 6C                        db 108 ; l3
   213 000000DC 38                        db 56  ; l0+l3
   214 000000DD 4F                        db 79  ; l1+l3
   215 000000DE 4C                        db 76 ; l0+l1+l3
   216                                  
   217 000000DF 26                        db 38  ; l2+l3
   218 000000E0 3C                        db 60  ; l0+l2+l3
   219 000000E1 54                        db 84  ; l1+l2+l3
   220 000000E2 0F                        db 15  ; l0+l1+l2+l3
   221                                  
   222                                  
   223                                  fptext:  ; pixel column k of each byte is bit k
   224 000000E3 2E6E0AEEEE0A              db 0x2e, 0x6e, 0x0a, 0xee, 0xee, 0x0a
   225 000000E9 26EE0EEE460E              db 0x26, 0xee, 0x0e, 0xee, 0x46, 0x0e
   226 000000EF E2CA0AA24A04              db 0xe2, 0xca, 0x0a, 0xa2, 0x4a, 0x04
