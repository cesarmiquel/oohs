     1                                  org 0x100
     2                                  
     3                                  %define tempo 30
     4                                  
     5                                  x2        equ   0x900
     6                                  incx      equ   0x902
     7                                  
     8                                  initial_time    equ 260
     9                                  
    10                                  init:
    11                                  
    12                                    ; setup gfx
    13 00000000 B013                    	mov al, 0x13
    14 00000002 CD10                    	int 0x10
    15 00000004 95                      	xchg bp, ax
    16 00000005 6800A0                  	push 0xa000
    17 00000008 07                      	pop es
    18                                  
    19                                    ; setup dos timer
    20 00000009 B81C25                    mov ax, 0x251c
    21 0000000C BA[C100]                	mov dx, timer
    22 0000000F CD21                    	int 0x21
    23                                  
    24                                    ; DELETE mov bp, initial_time
    25                                  
    26                                  top:
    27 00000011 B8CDCC                  	mov ax, 0xcccd
    28 00000014 F7E7                    	mul di  ; dh: y coord, dl: x coord + carry
    29                                  
    30                                    ;cmp dh, 64
    31                                    ;je draw
    32                                    ;cmp dh, 64+32
    33                                    ;je draw
    34                                    ;cmp dh, 64+32*2
    35                                    ;je draw
    36                                    ;cmp dh, 64+32*3+1
    37                                    ;ja blit2
    38                                  
    39                                    ; draw only lines in 0x40, 0x60, 0x80
    40 00000016 88F0                      mov al, dh         ; 2 bytes
    41 00000018 3CA1                      cmp al, 64+32*3+1
    42 0000001A 7776                      ja blit
    43 0000001C C0C003                    rol al, 3          ; 3 bytes  40h->02h, 60h->03h, 80h->04h
    44 0000001F 2C02                      sub al, 2          ; 2 bytes  -> 0, 1, 2
    45 00000021 3C02                      cmp al, 2          ; 2 bytes
    46 00000023 760F                      jbe draw           ; 2 bytes  unsigned: AL <= 2
    47                                  
    48 00000025 89FE                      mov si, di
    49 00000027 81EE4001                  sub si, 320
    50 0000002B B94001                    mov cx, 320
    51 0000002E FC                        cld
    52 0000002F 26F3A4                    es rep movsb
    53 00000032 EBDD                      jmp short top
    54                                  
    55                                  draw:
    56 00000034 C0EE05                    shr dh, 5 ; row - y/32
    57 00000037 80EE02                    sub dh, 2 ; row - 2
    58                                  
    59                                    ; 0 <= row < 3
    60 0000003A 7C56                      jl blit
    61 0000003C 80FE02                    cmp dh, 2
    62 0000003F 7F51                      jg blit
    63                                  
    64                                    ; load si with pointer to font row
    65 00000041 BE[E800]                  mov si, fptext
    66 00000044 31C0                      xor ax, ax
    67 00000046 88F0                      mov al, dh
    68 00000048 69C00600                  mul ax, 6   ; row * 6
    69 0000004C 01C6                      add si, ax
    70                                  
    71                                    ; save x and init x2
    72 0000004E 88D0                      mov al, dl
    73 00000050 3480                      xor al, 0x80
    74 00000052 98                        cbw ; convert 8-bit negative to 16-bit negative (ax)
    75 00000053 A30009                    mov word [x2], ax
    76 00000056 C0F803                    sar al, 3  ; shift right and preserve sign
    77                                  
    78 00000059 A20209                    mov byte [incx], al
    79                                  
    80 0000005C B201                      mov dl, 1
    81 0000005E B600                      mov dh, 0
    82                                  
    83                                  loop:
    84 00000060 A10009                    mov ax, word [x2]
    85 00000063 29E8                      sub ax, bp
    86                                    ;sub ax, -80
    87 00000065 7C1C                      jl .skip
    88                                  
    89 00000067 C1E805                    shr ax, 5  ; ofx = (x2-x1)/32
    90 0000006A 89C1                      mov cx, ax
    91 0000006C C1E803                    shr ax, 3  ; pos = ofx/8
    92 0000006F 3C05                      cmp al, 5
    93 00000071 7F49                      jg restart
    94                                  
    95 00000073 93                        xchg bx, ax
    96                                  
    97 00000074 30E4                      xor ah, ah
    98 00000076 8A00                      mov al, byte [si+bx]
    99 00000078 80E107                    and cl, 0x07
   100 0000007B D2E0                      shl al, cl
   101 0000007D 7304                      jnc .skip
   102                                  
   103 0000007F 88D1                      mov cl, dl
   104 00000081 08CE                      or dh, cl
   105                                  
   106                                  .skip:
   107 00000083 A00209                    mov al, byte [incx]
   108 00000086 98                        cbw
   109 00000087 01060009                  add word [x2], ax
   110                                  
   111 0000008B D0E2                      shl dl, 1
   112 0000008D 80FA10                    cmp dl, 0x10
   113 00000090 75CE                      jne loop
   114                                  
   115                                  blit:
   116 00000092 BB[D800]                  mov bx, palette
   117 00000095 88F0                      mov al, dh
   118 00000097 D7                        xlat
   119 00000098 AA                      	stosb
   120                                  
   121                                  
   122                                    ; DELETE
   123                                  ;.loop:
   124                                  ;  cmp di, 64*320 + 320*20
   125                                  ;  jg .loop
   126                                  
   127                                  	;inc di
   128                                  	;inc di
   129 00000099 85FF                      test di, di
   130 0000009B 0F8572FF                  jnz top
   131                                  
   132                                  ; - stabilizes image a bit
   133 0000009F BADA03                    mov dx, 3DAh
   134                                  .wait_start:
   135 000000A2 EC                        in al, dx
   136 000000A3 A808                      test al, 8
   137 000000A5 74FB                      jz .wait_start     ; wait for new retrace to begin
   138                                  
   139                                  ;  dec bp
   140 000000A7 4D                        dec bp
   141                                  
   142 000000A8 81FD00F9                  cmp bp, 0xf900
   143 000000AC 7F03                      jg .skip
   144                                  
   145 000000AE BD0401                    mov bp, initial_time
   146                                  
   147                                  .skip:
   148                                  
   149 000000B1 B01E                      mov al, tempo
   150 000000B3 E640                    	out 40h, al
   151 000000B5 E460                    	in al, 0x60
   152 000000B7 FEC8                    	dec al
   153 000000B9 E955FF                  	jmp top
   154                                  
   155                                  restart:
   156 000000BC 47                        inc di
   157 000000BD 0F8550FF                  jne top
   158                                  
   159                                  timer:
   160 000000C1 60                        pusha
   161                                  ;  dec bp
   162                                  ;
   163                                  ;  cmp bp, 0xf900
   164                                  ;  jg .skip
   165                                  ;
   166                                  ;  mov bp, initial_time
   167                                  ;
   168                                  ;.skip:
