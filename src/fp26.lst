    13                                  init:
    14                                  
    15                                    ; setup gfx
    16 00000000 B013                    	mov al, 0x13
    17 00000002 CD10                    	int 0x10
    18 00000004 95                      	xchg bp, ax
    19 00000005 68F69F                  	push 0xa000-10
    20 00000008 07                      	pop es
    21                                  
    22                                    ; setup dos timer
    23 00000009 B81C25                    mov ax, 0x251c
    24 0000000C BA[7600]                	mov dx, timer
    25 0000000F CD21                    	int 0x21
    26                                  
    27                                  top:
    28 00000011 B8CDCC                  	mov ax, 0xcccd
    29 00000014 F7E7                    	mul di  ; dh: y coord, dl: x coord + carry
    30                                  
    31                                  
    32 00000016 C606[6500]00              mov byte [idx+2], 0
    33                                  
    34 0000001B C0EE05                    shr dh, 5 ; row - y/32
    35 0000001E 80EE02                    sub dh, 2 ; row - 2
    36                                  
    37                                    ; 0 <= row < 3
    38 00000021 7C3D                      jl blit
    39 00000023 80FE02                    cmp dh, 2
    40 00000026 7F38                      jg blit
    41                                  
    42                                    ; load si with pointer to font row
    43 00000028 BE[8900]                  mov si, fptext
    44 0000002B 31C0                      xor ax, ax
    45 0000002D 88F0                      mov al, dh
    46 0000002F 69C00600                  mul ax, 6   ; row * 6
    47 00000033 01C6                      add si, ax
    48                                  
    49                                  loop:
    50 00000035 86C2                      xchg al, dl
    51 00000037 98                        cbw ; convert 8-bit negative to 16-bit negative (ax)
    52 00000038 89EA                      mov dx, bp
    53 0000003A 29D0                      sub ax, dx
    54 0000003C 3D0000                    cmp ax, 0
    55                                  
    56 0000003F 7C1F                      jl blit
    57                                  
    58 00000041 C1E804                    shr ax, 4  ; ofx = (x2-x1)/32
    59 00000044 50                        push ax
    60 00000045 C1E803                    shr ax, 3  ; pos = ofx/8
    61 00000048 3C05                      cmp al, 5
    62 0000004A 7F14                      jg  blit
    63                                  
    64                                    ;  TODO: usar bx para despues hacer [si + bx]
    65 0000004C 01C6                      add si, ax
    66                                  
    67 0000004E 30FF                      xor bh, bh
    68 00000050 8A1C                      mov bl, byte [si]
    69 00000052 59                        pop cx
    70 00000053 81E10700                  and cx, 0x0007
    71 00000057 D2E3                      shl bl, cl
    72 00000059 7305                      jnc skip
    73                                  
    74 0000005B C606[6500]0F              mov byte [idx+2], 0xf
    75                                  
    76                                  skip:
    77                                  blit:
    78 00000060 BE[7900]                  mov si, palette
    79                                  idx:
    80 00000063 83C602                    add si, byte 0x2
    81 00000066 AC                        lodsb
    82 00000067 AA                      	stosb
    83 00000068 47                      	inc di
    84 00000069 47                      	inc di
    85 0000006A 75A5                      jnz top
    86 0000006C B02A                      mov al, tempo
    86          ******************       warning: byte exceeds bounds [-w+number-overflow]
    87 0000006E E640                    	out 40h, al
    88 00000070 E460                    	in al, 0x60
    89 00000072 FEC8                    	dec al
    90 00000074 759B                    	jnz top
    91                                  
    92                                  
    93                                  timer:
    94 00000076 4D                        dec bp
    95 00000077 4D                        dec bp
    96 00000078 CF                        iret
