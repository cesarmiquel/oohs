   217                                  ;  db 0x8e, 0xa6, 0xa0, 0x8a, 0xa4, 0x40
   218                                  
   219                                  %ifdef MUSIC
   220                                  music:
   221                                    ; single note
   222                                    ;db 0xc3  ; change instrument on channel 3
   223                                    ;db 26    ; Instrument: https://en.wikipedia.org/wiki/General_MIDI#Sound_Effects
   224                                    ;db 0x93  ; play note on channel 10
   225                                    ;db 30    ; deep "b" = note number 35
   226                                    ;db 127    ; play with volume = 127
   227                                  
   228                                    ;db 0xc0  ; change instrument on channel 3
   229                                    ;db 89    ; Instrument: https://en.wikipedia.org/wiki/General_MIDI#Sound_Effects
   230                                    ;db 0x90   ; play note on channel 10
   231                                    ;db 55   ; deep "b" = note number 35
   232                                    ;db 0    ; play with volume = 127
   233                                  
   234                                    ; Drum channel / K.O.II
   235 000000F7 99                        db 0x99   ; play note on channel 10 (drums)
   236 000000F8 24                        db 36
   237 000000F9 6E                        db 110    ; play with volume = 127
   238 000000FA 99                        db 0x99   ; play note on channel 10 (drums)
   239 000000FB 3E                        db 62
   240 000000FC 6E                        db 110    ; play with volume = 127
   241                                  
   242                                  pattern:
   243 000000FD 98                        db 0b10011000
   244 000000FE AF                        db 0b10101111
