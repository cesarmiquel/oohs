   173                                  
   174                                    ; wait for ESC
   175                                    ;in ax, 0x60
   176                                    ;dec al
   177                                  ;jnz restart
   178                                  
   179                                  restart:
   180 000000C3 47                        inc di
   181 000000C4 0F8541FF                  jne top
   182                                  
   183                                  quit:
   184 000000C8 C3                        ret
