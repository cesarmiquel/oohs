   234                                  
   235                                  %ifdef MUSIC
   236                                  music:
   237                                    ; single note
   238                                    ;db 0xc3  ; change instrument on channel 3
   239                                    ;db 26    ; Instrument: https://en.wikipedia.org/wiki/General_MIDI#Sound_Effects
   240                                    ;db 0x93  ; play note on channel 10
   241                                    ;db 30    ; deep "b" = note number 35
   242                                    ;db 127    ; play with volume = 127
   243                                  
   244 000000EB C0                        db 0xc0  ; change instrument on channel 3
   245 000000EC 29                        db 41    ; Instrument: https://en.wikipedia.org/wiki/General_MIDI#Sound_Effects
   246 000000ED 90                        db 0x90   ; play note on channel 10
   247 000000EE 2D                        db 45   ; deep "b" = note number 35
   248 000000EF 7F                        db 127    ; play with volume = 127
   249                                  
   250                                    ; Drum channel / K.O.II
   251 000000F0 99                        db 0x99   ; play note on channel 10 (drums)
   252 000000F1 28                        db 40
   253 000000F2 6E                        db 110    ; play with volume = 127
   254 000000F3 99                        db 0x99   ; play note on channel 10 (drums)
   255                                    ;db 62
   256 000000F4 3E                        db 62
   257 000000F5 50                        db 80    ; play with volume = 127
