    99 00000079 007C0232                  db 0, 124, 2, 50
   100 0000007D 04197447                  db 4, 25, 116, 71
   101 00000081 224F4F4C                  db 34, 79, 79, 76
   102 00000085 243C540F                  db 36, 60, 84, 15
   103                                  
