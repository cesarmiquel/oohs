   222 000000D8 0F                        db 15  ; l0+l1+l2+l3
   223                                  
   224                                  
   225                                  fptext:  ; pixel column k of each byte is bit k
   226 000000D9 2E6E0AEEEE0A              db 0x2e, 0x6e, 0x0a, 0xee, 0xee, 0x0a
   227 000000DF 26EE0EEE460E              db 0x26, 0xee, 0x0e, 0xee, 0x46, 0x0e
   228 000000E5 E2CA0AA24A04              db 0xe2, 0xca, 0x0a, 0xa2, 0x4a, 0x04
