     1                                  org 0x100
     2                                  
     3                                  %define tempo 30
     4                                  
     5                                  x2        equ   0x900
     6                                  
     7                                  initial_time    equ 260
     8                                  
     9                                  init:
    10                                  
    11                                    ; setup gfx
    12 00000000 B013                    	mov al, 0x13
    13 00000002 CD10                    	int 0x10
    14 00000004 95                      	xchg bp, ax
    15 00000005 6800A0                  	push 0xa000
    16 00000008 07                      	pop es
    17                                  
    18                                    ; setup dos timer
    19                                    ;mov ax, 0x251c
    20                                  	;mov dx, timer
    21                                  	;int 0x21
    22                                  
    23                                    ; DELETE mov bp, initial_time
    24                                  
    25                                  top:
    26 00000009 B8CDCC                  	mov ax, 0xcccd
    27 0000000C F7E7                    	mul di  ; dh: y coord, dl: x coord + carry
    28                                  
    29                                    ;cmp dh, 64
    30                                    ;je draw
    31                                    ;cmp dh, 64+32
    32                                    ;je draw
    33                                    ;cmp dh, 64+32*2
    34                                    ;je draw
    35                                    ;cmp dh, 64+32*3+1
    36                                    ;ja blit2
    37                                  
    38                                    ; draw only lines in 0x40, 0x60, 0x80
    39 0000000E 88F0                      mov al, dh         ; 2 bytes
    40 00000010 3CA1                      cmp al, 64+32*3+1
    41 00000012 7756                      ja blit
    42 00000014 C0C003                    rol al, 3          ; 3 bytes  40h->02h, 60h->03h, 80h->04h
    43 00000017 2C02                      sub al, 2          ; 2 bytes  -> 0, 1, 2
    44 00000019 3C02                      cmp al, 2          ; 2 bytes
    45 0000001B 760C                      jbe draw           ; 2 bytes  unsigned: AL <= 2
    46                                  
    47 0000001D 8DB5C0FE                  lea si, [di-320]
    48 00000021 B94001                    mov cx, 320
    49 00000024 26F3A4                    es rep movsb
    50 00000027 EBE0                      jmp short top
    51                                  
    52                                  draw:
    53 00000029 88C6                      mov dh, al
    54                                  
    55                                    ; load si with pointer to font row
    56                                    ;mov si, fptext
    57 0000002B B400                      mov ah, 0
    58 0000002D 69C00600                  mul ax, 6   ; row * 6
    59 00000031 89C6                      mov si, ax
    60                                  
    61                                    ; save x and init x2
    62 00000033 88D0                      mov al, dl
    63 00000035 3480                      xor al, 0x80
    64 00000037 98                        cbw ; convert 8-bit negative to 16-bit negative (ax)
    65 00000038 A30009                    mov word [x2], ax
    66 0000003B C0F803                    sar al, 3  ; shift right and preserve sign
    67                                  
    68 0000003E BA0100                    mov dx, 1   ; dl loop counter, dh = 0 (idx)
    69 00000041 88C5                      mov ch, al  ; x/8
    70                                  
    71                                  loop:
    72 00000043 A10009                    mov ax, word [x2]
    73 00000046 29E8                      sub ax, bp
    74                                    ;sub ax, -80
    75 00000048 7C12                      jl .skip
    76                                  
    77 0000004A C1E805                    shr ax, 5  ; ofx = (x2-x1)/32
    78 0000004D 3C2F                      cmp al, 47
    79 0000004F 7F7C                      jg restart
    80                                  
    81 00000051 30E4                      xor ah, ah
    82 00000053 0FA384[E300]              bt [si+fptext], ax
    83 00000058 7302                      jnc .skip
    84                                  
    85 0000005A 08D6                      or dh, dl
    86                                  
    87                                  .skip:
    88 0000005C 88E8                      mov al, ch
    89 0000005E 98                        cbw
    90 0000005F 01060009                  add word [x2], ax
    91                                  
    92 00000063 D0E2                      shl dl, 1
    93 00000065 80FA10                    cmp dl, 0x10
    94 00000068 75D9                      jne loop
    95                                  
    96                                  blit:
    97 0000006A BB[D300]                  mov bx, palette
    98 0000006D 88F0                      mov al, dh
    99 0000006F D7                        xlat
   100 00000070 AA                      	stosb
   101                                  
   102 00000071 85FF                      test di, di
   103 00000073 7594                      jnz top
   104                                  
   105                                  ; - stabilizes image a bit
   106 00000075 BADA03                    mov dx, 3DAh
   107                                  .wait_start:
   108 00000078 EC                        in al, dx
   109 00000079 A808                      test al, 8
   110 0000007B 74FB                      jz .wait_start     ; wait for new retrace to begin
   111                                  
   112 0000007D 4D                        dec bp
   113                                  
   114                                  %ifdef MUSIC
   115                                    ; Music
   116 0000007E F7C50700                  test bp, 0x07
   117 00000082 7536                      jnz skip_play
   118                                  
   119 00000084 BE[F500]                  mov si, music
   120                                  
   121                                  ch1:
   122                                    ; silence ch1 and set fixed volume for ch2
   123 00000087 C6440700                  mov byte [si + 2 + 5], 0      ; ch1
   124 0000008B C6440A5A                  mov byte [si + 5 + 5], 90     ; ch2
   125                                  
   126                                    ; pattern 1
   127 0000008F D0440B                    rol byte [si + 6 + 5], 1
   128 00000092 7208                      jc skipmute1
   129                                  
   130                                    ; mute ch1
   131 00000094 C6440700                  mov byte [si + 2 + 5], 0
   132                                  
   133                                    ; use pattern 1 to gate the synth channel (ch0)
   134 00000098 8074047F                  xor byte [si + 4], 0x7f
   135                                  
   136                                  skipmute1:
   137 0000009C D0440C                    rol byte [si + 7 + 5], 1
   138 0000009F 7204                      jc skipmute2
   139                                  
   140                                    ; mute ch 2
   141 000000A1 C6440A00                  mov byte [si + 5 + 5], 0
   142                                  
   143                                  skipmute2:
   144                                    ; switches instruments of ch1 and ch2
   145 000000A5 80740601                  xor byte [si + 1 + 5], 1
   146 000000A9 80740901                  xor byte [si + 4 + 5], 1
   147                                  
   148                                  playmidi:
   149 000000AD BA3003                    mov dx, 0x330
   150 000000B0 B10B                      mov cl, 6 + 5
   151 000000B2 F36E                      rep  outsb
   152 000000B4 42                        inc dx
   153 000000B5 6E                        outsb
   154                                  
   155                                    ; increase volume of ch1
   156                                  incvol:
   157 000000B6 FE06[8A00]                inc [ch1+3]
   158                                  %endif
   159                                  
   160                                  skip_play:
   161 000000BA 81FD90FD                  cmp bp, 0xfd90
   162 000000BE 7F0D                      jg .skip
   163 000000C0 C606[F800]39              mov [music+3], 57
   164                                  
   165 000000C5 81FDB0F9                  cmp bp, 0xf9b0
   166 000000C9 7F02                      jg .skip
   167                                  
   168 000000CB EB05                      jmp short quit
   169                                    ;mov bp, initial_time ; reset timer to repeat
   170                                  
   171                                  .skip:
   172                                  
   173                                    ;mov al, tempo
   174                                  	;out 40h, al
   175                                  	;in al, 0x60
   176                                  	;dec al
   177                                  	;jmp top
   178                                  
   179                                    ; wait for ESC
   180                                    ;in ax, 0x60
   181                                    ;dec al
   182                                  ;jnz restart
   183                                  
   184                                  restart:
   185 000000CD 47                        inc di
   186 000000CE 0F8537FF                  jne top
   187                                  
   188                                  quit:
   189 000000D2 C3                        ret
