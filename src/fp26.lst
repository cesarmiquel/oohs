    32                                  
    33 00000019 C606[9F00]00              mov byte [palidx+2], 0
    34                                  
    35                                    ;cmp dh, 64
    36                                    ;je draw
    37                                    ;cmp dh, 64+32
    38                                    ;je draw
    39                                    ;cmp dh, 64+32*2
    40                                    ;je draw
    41                                    ;cmp dh, 64+32*3+1
    42                                    ;ja blit2
    43                                  
    44                                    ; draw only lines in 0x40, 0x60, 0x80
    45 0000001E 88F0                      mov al, dh         ; 2 bytes
    46 00000020 3CA1                      cmp al, 64+32*3+1
    47 00000022 7776                      ja blit
    48 00000024 C0C003                    rol al, 3          ; 3 bytes  40h->02h, 60h->03h, 80h->04h
    49 00000027 2C02                      sub al, 2          ; 2 bytes  -> 0, 1, 2
    50 00000029 3C02                      cmp al, 2          ; 2 bytes
    51 0000002B 760F                      jbe draw           ; 2 bytes  unsigned: AL <= 2
    52                                  
    53 0000002D 89FE                      mov si, di
    54 0000002F 81EE4001                  sub si, 320
    55 00000033 B94001                    mov cx, 320
    56 00000036 FC                        cld
    57 00000037 26F3A4                    es rep movsb
    58 0000003A EBD8                      jmp short top
    59                                  
    60                                  draw:
    61 0000003C C0EE05                    shr dh, 5 ; row - y/32
    62 0000003F 80EE02                    sub dh, 2 ; row - 2
    63                                  
    64                                    ; 0 <= row < 3
    65 00000042 7C56                      jl blit
    66 00000044 80FE02                    cmp dh, 2
    67 00000047 7F51                      jg blit
    68                                  
    69                                    ; load si with pointer to font row
    70 00000049 BE[D000]                  mov si, fptext
    71 0000004C 31C0                      xor ax, ax
    72 0000004E 88F0                      mov al, dh
    73 00000050 69C00600                  mul ax, 6   ; row * 6
    74 00000054 01C6                      add si, ax
    75                                  
    76                                    ; save x and init x2
    77 00000056 88D0                      mov al, dl
    78 00000058 3480                      xor al, 0x80
    79 0000005A 98                        cbw ; convert 8-bit negative to 16-bit negative (ax)
    80 0000005B A30009                    mov word [x2], ax
    81 0000005E C0F803                    sar al, 3  ; shift right and preserve sign
    82 00000061 A20209                    mov byte [incx], al
    83                                  
    84 00000064 B201                      mov dl, 1
    85                                  
    86                                  loop:
    87 00000066 A10009                    mov ax, word [x2]
    88 00000069 29E8                      sub ax, bp
    89                                    ;sub ax, -80
    90 0000006B 7C1E                      jl .skip
    91                                  
    92 0000006D C1E805                    shr ax, 5  ; ofx = (x2-x1)/32
    93 00000070 89C1                      mov cx, ax
    94 00000072 C1E803                    shr ax, 3  ; pos = ofx/8
    95 00000075 3C05                      cmp al, 5
    96 00000077 7F3A                      jg restart
    97                                  
    98 00000079 93                        xchg bx, ax
    99                                  
   100 0000007A 30E4                      xor ah, ah
   101 0000007C 8A00                      mov al, byte [si+bx]
   102 0000007E 80E107                    and cl, 0x07
   103 00000081 D2E0                      shl al, cl
   104 00000083 7306                      jnc .skip
   105                                  
   106 00000085 88D1                      mov cl, dl
   107 00000087 080E[9F00]                or byte [palidx+2], cl
   108                                  
   109                                  .skip:
   110 0000008B A00209                    mov al, byte [incx]
   111 0000008E 98                        cbw
