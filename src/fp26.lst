   170                                  %ifdef MUSIC
   171                                    ; Music
   172 000000C2 89E9                      mov cx, bp
   173 000000C4 81E11F00                  and cx, 0x1f
   174 000000C8 750C                      jnz skip_play
   175                                  
   176                                    ;mov [music + 2], di
   177                                    ;add [music + 3], 50
   178                                    ;and [music + 3], 0x3f
   179                                  
   180 000000CA BA3003                    mov dx, 0x330
   181 000000CD BE[FA00]                  mov si, music
   182 000000D0 B105                      mov cl, 5
   183 000000D2 F36E                      rep  outsb
   184 000000D4 42                        inc dx
   185 000000D5 6E                        outsb
   186                                  %endif
   187                                  
   188                                  skip_play:
   189 000000D6 61                        popa
   190 000000D7 CF                        iret
   191                                  
   192                                  palette:
   193                                    ;db 0, 124, 2, 50
   194                                    ;db 4, 25, 116, 71
   195                                    ;db 34, 79, 79, 76
   196                                    ;db 36, 60, 84, 15
   197                                  
   198 000000D8 00                        db 0
   199 000000D9 03                        db 3   ; l0
   200 000000DA 7C                        db 124 ; l1
   201 000000DB 34                        db 52  ; l0+l1
   202                                  
   203 000000DC 04                        db 4   ; l2
   204 000000DD 34                        db 52  ; l0+l2
   205 000000DE 1B                        db 27  ; l1+l2
   206 000000DF 64                        db 100 ; l0+l1+l2
   207                                  
   208 000000E0 6C                        db 108 ; l3
   209 000000E1 38                        db 56  ; l0+l3
   210 000000E2 4F                        db 79  ; l1+l3
   211 000000E3 4C                        db 76 ; l0+l1+l3
   212                                  
   213 000000E4 26                        db 38  ; l2+l3
   214 000000E5 3C                        db 60  ; l0+l2+l3
   215 000000E6 54                        db 84  ; l1+l2+l3
   216 000000E7 0F                        db 15  ; l0+l1+l2+l3
   217                                  
