    89 0000006B 7C1E                      jl .skip
    90                                  
    91 0000006D C1E805                    shr ax, 5  ; ofx = (x2-x1)/32
    92 00000070 89C1                      mov cx, ax
    93 00000072 C1E803                    shr ax, 3  ; pos = ofx/8
    94 00000075 3C05                      cmp al, 5
    95 00000077 7F4C                      jg restart
    96                                  
    97 00000079 93                        xchg bx, ax
    98                                  
    99 0000007A 30E4                      xor ah, ah
   100 0000007C 8A00                      mov al, byte [si+bx]
   101 0000007E 80E107                    and cl, 0x07
   102 00000081 D2E0                      shl al, cl
   103 00000083 7306                      jnc .skip
   104                                  
   105 00000085 88D1                      mov cl, dl
   106 00000087 080E0409                  or byte [idx], cl
   107                                  
