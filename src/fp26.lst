     1                                  org 0x100
     2                                  
     3                                  x2        equ   0x900
     4                                  
     5                                  init:
     6                                  
     7                                    ; setup gfx
     8 00000000 B013                    	mov al, 0x13
     9 00000002 CD10                    	int 0x10
    10 00000004 95                      	xchg bp, ax
    11 00000005 6800A0                  	push 0xa000
    12 00000008 07                      	pop es
    13                                  
    14                                  top:
    15 00000009 B8CDCC                  	mov ax, 0xcccd
    16 0000000C F7E7                    	mul di  ; dh: y coord, dl: x coord + carry
    17                                  
    18                                    ; draw only lines in 0x40, 0x60, 0x80
    19 0000000E 88F0                      mov al, dh         ; 2 bytes
    20 00000010 3CA1                      cmp al, 64+32*3+1
    21 00000012 7754                      ja blit
    22 00000014 C0C003                    rol al, 3          ; 3 bytes  40h->02h, 60h->03h, 80h->04h
    23 00000017 2C02                      sub al, 2          ; 2 bytes  -> 0, 1, 2
    24 00000019 3C02                      cmp al, 2          ; 2 bytes
    25 0000001B 760C                      jbe draw           ; 2 bytes  unsigned: AL <= 2
    26                                  
    27 0000001D 8DB5C0FE                  lea si, [di-320]
    28 00000021 B94001                    mov cx, 320
    29 00000024 26F3A4                    es rep movsb
    30 00000027 EBE0                      jmp short top
    31                                  
    32                                  draw:
    33 00000029 88C6                      mov dh, al
    34                                  
    35                                    ; load si with pointer to font row
    36 0000002B B400                      mov ah, 0
    37 0000002D 69C00600                  mul ax, 6   ; row * 6
    38 00000031 89C6                      mov si, ax
    39                                  
    40                                    ; save x and init x2
    41 00000033 88D0                      mov al, dl
    42 00000035 3480                      xor al, 0x80
    43 00000037 98                        cbw ; convert 8-bit negative to 16-bit negative (ax)
    44 00000038 A30009                    mov word [x2], ax
    45 0000003B C0F803                    sar al, 3  ; shift right and preserve sign
    46                                  
    47 0000003E BA0100                    mov dx, 1   ; dl loop counter, dh = 0 (idx)
    48 00000041 88C5                      mov ch, al  ; x/8
    49                                  
    50                                  loop:
    51 00000043 A10009                    mov ax, word [x2]
    52 00000046 29E8                      sub ax, bp
    53 00000048 7C10                      jl .skip
    54                                  
    55 0000004A C1E805                    shr ax, 5  ; ofx = (x2-x1)/32
    56 0000004D 3C2F                      cmp al, 47
    57 0000004F 7F79                      jg restart
    58                                  
    59                                    ;xor ah, ah
    60 00000051 0FA384[E000]              bt [si+fptext], ax
    61 00000056 7302                      jnc .skip
    62                                  
    63 00000058 08D6                      or dh, dl
    64                                  
    65                                  .skip:
    66 0000005A 88E8                      mov al, ch
    67 0000005C 98                        cbw
    68 0000005D 01060009                  add word [x2], ax
    69                                  
    70 00000061 D0E2                      shl dl, 1
    71 00000063 80FA10                    cmp dl, 0x10
    72 00000066 75DB                      jne loop
    73                                  
    74                                  blit:
    75 00000068 BB[D000]                  mov bx, palette
    76 0000006B 88F0                      mov al, dh
    77 0000006D D7                        xlat
    78 0000006E AA                      	stosb
    79                                  
    80 0000006F 85FF                      test di, di
    81 00000071 7596                      jnz top
    82                                  
    83                                  ; - stabilizes image a bit
    84 00000073 BADA03                    mov dx, 3DAh
    85                                  .wait_start:
    86 00000076 EC                        in al, dx
    87 00000077 A808                      test al, 8
    88 00000079 74FB                      jz .wait_start     ; wait for new retrace to begin
    89                                  
    90 0000007B 4D                        dec bp
    91                                  
    92                                    ; Music
    93 0000007C BE[F200]                  mov si, music
    94 0000007F F7C50700                  test bp, 0x07
    95 00000083 7533                      jnz skip_play
    96                                  
    97                                  ch1:
    98                                    ; silence ch1 and set fixed volume for ch2
    99 00000085 C6440700                  mov byte [si + 2 + 5], 0      ; ch1
   100 00000089 C6440A5A                  mov byte [si + 5 + 5], 90     ; ch2
   101                                  
   102                                    ; pattern 1
   103 0000008D D0440B                    rol byte [si + 6 + 5], 1
   104 00000090 7208                      jc skipmute1
   105                                  
   106                                    ; mute ch1
   107 00000092 C6440700                  mov byte [si + 2 + 5], 0
   108                                  
   109                                    ; use pattern 1 to gate the synth channel (ch0)
   110 00000096 8074047F                  xor byte [si + 4], 0x7f
   111                                  
   112                                  skipmute1:
   113 0000009A D0440C                    rol byte [si + 7 + 5], 1
   114 0000009D 7204                      jc skipmute2
   115                                  
   116                                    ; mute ch 2
   117 0000009F C6440A00                  mov byte [si + 5 + 5], 0
   118                                  
   119                                  skipmute2:
   120                                    ; switches instruments of ch1 and ch2
   121 000000A3 80740601                  xor byte [si + 1 + 5], 1
   122 000000A7 80740901                  xor byte [si + 4 + 5], 1
   123                                  
   124                                  playmidi:
   125 000000AB BA3003                    mov dx, 0x330
   126 000000AE B10B                      mov cl, 6 + 5
   127 000000B0 F36E                      rep  outsb
   128 000000B2 42                        inc dx
   129 000000B3 6E                        outsb
   130                                  
   131                                    ; increase volume of ch1
   132                                  incvol:
   133 000000B4 FE06[8800]                inc [ch1+3]
   134                                  
   135                                  skip_play:
   136 000000B8 81FD90FD                  cmp bp, 0xfd90
   137 000000BC 7F0C                      jg .skip
   138 000000BE C6440339                  mov [si+3], 57
   139                                  
   140 000000C2 81FDB0F9                  cmp bp, 0xf9b0
   141 000000C6 7F02                      jg .skip
   142                                  
   143 000000C8 EB05                      jmp short quit
   144                                  
   145                                  .skip:
   146                                  
   147                                  restart:
   148 000000CA 47                        inc di
   149 000000CB 0F853AFF                  jne top
   150                                  
   151                                  quit:
   152 000000CF C3                        ret
   153                                  
   154                                  palette:
   155 000000D0 00                        db 0
   156 000000D1 03                        db 3   ; l0
   157 000000D2 7C                        db 124 ; l1
   158 000000D3 34                        db 52  ; l0+l1
   159                                  
   160 000000D4 04                        db 4   ; l2
   161 000000D5 34                        db 52  ; l0+l2
   162 000000D6 1B                        db 27  ; l1+l2
   163 000000D7 64                        db 100 ; l0+l1+l2
   164                                  
   165 000000D8 6C                        db 108 ; l3
   166 000000D9 38                        db 56  ; l0+l3
   167 000000DA 4F                        db 79  ; l1+l3
   168 000000DB 4C                        db 76 ; l0+l1+l3
   169                                  
   170 000000DC 26                        db 38  ; l2+l3
   171 000000DD 3C                        db 60  ; l0+l2+l3
   172 000000DE 54                        db 84  ; l1+l2+l3
   173 000000DF 0F                        db 15  ; l0+l1+l2+l3
   174                                  
   175                                  
   176                                  fptext:  ; pixel column k of each byte is bit k
   177 000000E0 2E6E0AEEEE0A              db 0x2e, 0x6e, 0x0a, 0xee, 0xee, 0x0a
   178 000000E6 26EE0EEE460E              db 0x26, 0xee, 0x0e, 0xee, 0x46, 0x0e
   179 000000EC E2CA0AA24A04              db 0xe2, 0xca, 0x0a, 0xa2, 0x4a, 0x04
   180                                  
   181                                  music:
   182                                    ; synth channel
   183 000000F2 C0                        db 0xc0  ; change instrument on channel 3
   184 000000F3 35                        db 53    ; Instrument: https://en.wikipedia.org/wiki/General_MIDI#Sound_Effects
   185 000000F4 90                        db 0x90  ; play note on channel 10
   186 000000F5 37                        db 55    ; note number 45
   187 000000F6 7F                        db 127   ; set volume to 127 but it will be gated
   188                                  
   189                                    ; Drum channel / K.O.II
   190 000000F7 99                        db 0x99   ; play note on channel 10 (drums)
   191 000000F8 28                        db 40
   192 000000F9 6E                        db 110    ; play with volume = 127
   193 000000FA 99                        db 0x99   ; play note on channel 10 (drums)
   194 000000FB 3E                        db 62
   195 000000FC 50                        db 80    ; play with volume = 127
   196                                  
   197                                  pattern:
   198 000000FD 98                        db 0b10011000 ; pattern 1
   199 000000FE 6C                        db 0b01101100 ; pattern 2
