    12                                  init:
    13                                  
    14                                    ; setup gfx
    15 00000000 B013                    	mov al, 0x13
    16 00000002 CD10                    	int 0x10
    17 00000004 95                      	xchg bp, ax
    18 00000005 68F69F                  	push 0xa000-10
    19 00000008 07                      	pop es
    20                                  
    21                                    ; setup dos timer
    22 00000009 B81C25                    mov ax, 0x251c
    23 0000000C BA[AC00]                	mov dx, timer
    24 0000000F CD21                    	int 0x21
    25                                  
    26                                  
    27                                  top:
    28 00000011 B8CDCC                  	mov ax, 0xcccd
    29 00000014 F7E7                    	mul di  ; dh: y coord, dl: x coord + carry
    30                                  
    31 00000016 C606[8700]00              mov byte [palidx+2], 0
    32                                  
    33                                    ;cmp dh, 64
    34                                    ;je draw
    35                                    ;;cmp dh, 65+32
    36                                    ;;je draw
