   202                                  
   203                                  palette:
   204                                    ;db 0, 124, 2, 50
   205                                    ;db 4, 25, 116, 71
   206                                    ;db 34, 79, 79, 76
   207                                    ;db 36, 60, 84, 15
   208                                  
   209 000000D3 00                        db 0
   210 000000D4 03                        db 3   ; l0
   211 000000D5 7C                        db 124 ; l1
   212 000000D6 34                        db 52  ; l0+l1
   213                                  
   214 000000D7 04                        db 4   ; l2
   215 000000D8 34                        db 52  ; l0+l2
   216 000000D9 1B                        db 27  ; l1+l2
   217 000000DA 64                        db 100 ; l0+l1+l2
   218                                  
   219 000000DB 6C                        db 108 ; l3
   220 000000DC 38                        db 56  ; l0+l3
   221 000000DD 4F                        db 79  ; l1+l3
   222 000000DE 4C                        db 76 ; l0+l1+l3
   223                                  
   224 000000DF 26                        db 38  ; l2+l3
   225 000000E0 3C                        db 60  ; l0+l2+l3
   226 000000E1 54                        db 84  ; l1+l2+l3
   227 000000E2 0F                        db 15  ; l0+l1+l2+l3
   228                                  
   229                                  
   230                                  fptext:  ; pixel column k of each byte is bit k
   231 000000E3 2E6E0AEEEE0A              db 0x2e, 0x6e, 0x0a, 0xee, 0xee, 0x0a
   232 000000E9 26EE0EEE460E              db 0x26, 0xee, 0x0e, 0xee, 0x46, 0x0e
   233 000000EF E2CA0AA24A04              db 0xe2, 0xca, 0x0a, 0xa2, 0x4a, 0x04
   234                                  
   235                                  ;fptext:
   236                                  ;  db 0xe8, 0xec, 0xa0, 0xee, 0xee, 0xa0
   237                                  ;  db 0xc8, 0xee, 0xe0, 0xee, 0xc4, 0xe0
   238                                  ;  db 0x8e, 0xa6, 0xa0, 0x8a, 0xa4, 0x40
   239                                  
   240                                  %ifdef MUSIC
   241                                  music:
   242                                    ; synth channel
   243 000000F5 C0                        db 0xc0  ; change instrument on channel 3
   244                                    ;db 52/53    ; Weird voice like effect. Instrument: https://en.wikipedia.org/wiki/General_MIDI#Sound_Effects
   245                                    ; violin: db 41    ; Instrument: https://en.wikipedia.org/wiki/General_MIDI#Sound_Effects
   246 000000F6 35                        db 53    ; Instrument: https://en.wikipedia.org/wiki/General_MIDI#Sound_Effects
   247 000000F7 90                        db 0x90  ; play note on channel 10
   248 000000F8 37                        db 55    ; note number 45
   249 000000F9 7F                        db 127   ; set volume to 127 but it will be gated
   250                                  
   251                                    ; Drum channel / K.O.II
   252 000000FA 99                        db 0x99   ; play note on channel 10 (drums)
   253 000000FB 28                        db 40
   254 000000FC 6E                        db 110    ; play with volume = 127
   255 000000FD 99                        db 0x99   ; play note on channel 10 (drums)
   256 000000FE 3E                        db 62
   257 000000FF 50                        db 80    ; play with volume = 127
   258                                  
   259                                  pattern:
   260 00000100 98                        db 0b10011000 ; pattern 1
   261 00000101 6C                        db 0b01101100 ; pattern 2
   262                                  %endif
