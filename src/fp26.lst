   232                                  
   233                                  %ifdef MUSIC
   234                                  music:
   235                                    ; single note
   236                                    ;db 0xc3  ; change instrument on channel 3
   237                                    ;db 26    ; Instrument: https://en.wikipedia.org/wiki/General_MIDI#Sound_Effects
   238                                    ;db 0x93  ; play note on channel 10
   239                                    ;db 30    ; deep "b" = note number 35
   240                                    ;db 127    ; play with volume = 127
   241                                  
   242 000000F5 C0                        db 0xc0  ; change instrument on channel 3
   243 000000F6 29                        db 41    ; Instrument: https://en.wikipedia.org/wiki/General_MIDI#Sound_Effects
   244 000000F7 90                        db 0x90   ; play note on channel 10
   245 000000F8 2D                        db 45   ; deep "b" = note number 35
   246 000000F9 7F                        db 127    ; play with volume = 127
   247                                  
   248                                    ; Drum channel / K.O.II
   249 000000FA 99                        db 0x99   ; play note on channel 10 (drums)
   250 000000FB 28                        db 40
   251 000000FC 6E                        db 110    ; play with volume = 127
   252 000000FD 99                        db 0x99   ; play note on channel 10 (drums)
   253 000000FE 3E                        db 62
   254 000000FF 6E                        db 110    ; play with volume = 127
