   185                                  
   186 000000DB 00                        db 0
   187 000000DC 03                        db 3   ; l0
   188 000000DD 7C                        db 124 ; l1
   189 000000DE 34                        db 52  ; l0+l1
   190                                  
   191 000000DF 04                        db 4   ; l2
   192 000000E0 34                        db 52  ; l0+l2
   193 000000E1 1B                        db 27  ; l1+l2
   194 000000E2 64                        db 100 ; l0+l1+l2
   195                                  
   196 000000E3 6C                        db 108 ; l3
   197 000000E4 38                        db 56  ; l0+l3
   198 000000E5 4F                        db 79  ; l1+l3
   199 000000E6 4C                        db 76 ; l0+l1+l3
   200                                  
   201 000000E7 26                        db 38  ; l2+l3
   202 000000E8 3C                        db 60  ; l0+l2+l3
