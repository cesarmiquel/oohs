    41                                    ;ja blit2
    42                                  
    43                                    ; draw only lines in 0x40, 0x60, 0x80
    44 0000001E 88F0                      mov al, dh         ; 2 bytes
    45 00000020 3CA1                      cmp al, 64+32*3+1
    46 00000022 7776                      ja blit
    47 00000024 C0C003                    rol al, 3          ; 3 bytes  40h->02h, 60h->03h, 80h->04h
    48 00000027 2C02                      sub al, 2          ; 2 bytes  -> 0, 1, 2
    49 00000029 3C02                      cmp al, 2          ; 2 bytes
    50 0000002B 760F                      jbe draw           ; 2 bytes  unsigned: AL <= 2
    51                                  
    52 0000002D 89FE                      mov si, di
    53 0000002F 81EE4001                  sub si, 320
    54 00000033 B94001                    mov cx, 320
    55 00000036 FC                        cld
    56 00000037 26F3A4                    es rep movsb
    57 0000003A EBD8                      jmp short top
    58                                  
    59                                  draw:
    60 0000003C C0EE05                    shr dh, 5 ; row - y/32
    61 0000003F 80EE02                    sub dh, 2 ; row - 2
    62                                  
    63                                    ; 0 <= row < 3
    64 00000042 7C56                      jl blit
    65 00000044 80FE02                    cmp dh, 2
    66 00000047 7F51                      jg blit
    67                                  
    68                                    ; load si with pointer to font row
    69 00000049 BE[F800]                  mov si, fptext
    70 0000004C 31C0                      xor ax, ax
    71 0000004E 88F0                      mov al, dh
    72 00000050 69C00600                  mul ax, 6   ; row * 6
    73 00000054 01C6                      add si, ax
    74                                  
    75                                    ; save x and init x2
    76 00000056 88D0                      mov al, dl
    77 00000058 3480                      xor al, 0x80
    78 0000005A 98                        cbw ; convert 8-bit negative to 16-bit negative (ax)
    79 0000005B A30009                    mov word [x2], ax
    80 0000005E C0F803                    sar al, 3  ; shift right and preserve sign
    81 00000061 A20209                    mov byte [incx], al
    82                                  
    83 00000064 B201                      mov dl, 1
    84                                  
    85                                  loop:
    86 00000066 A10009                    mov ax, word [x2]
    87 00000069 29E8                      sub ax, bp
