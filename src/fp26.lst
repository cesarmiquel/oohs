   219                                  fptext:
   220 000000E8 E8ECA0EEEEA0              db 0xe8, 0xec, 0xa0, 0xee, 0xee, 0xa0
   221 000000EE C8EEE0EEC4E0              db 0xc8, 0xee, 0xe0, 0xee, 0xc4, 0xe0
   222 000000F4 8EA6A08AA440              db 0x8e, 0xa6, 0xa0, 0x8a, 0xa4, 0x40
   223                                  
   224                                  %ifdef MUSIC
   225                                  music:
   226                                    ; single note
   227                                    ;db 0xc3  ; change instrument on channel 3
   228                                    ;db 26    ; Instrument: https://en.wikipedia.org/wiki/General_MIDI#Sound_Effects
   229                                    ;db 0x93  ; play note on channel 10
   230                                    ;db 30    ; deep "b" = note number 35
   231                                    ;db 127    ; play with volume = 127
   232                                  
   233 000000FA C0                        db 0xc0  ; change instrument on channel 3
   234 000000FB 59                        db 89    ; Instrument: https://en.wikipedia.org/wiki/General_MIDI#Sound_Effects
   235                                    ;db 0x90   ; play note on channel 10
   236                                    ;db 35   ; deep "b" = note number 35
   237                                    ;db 127    ; play with volume = 127
