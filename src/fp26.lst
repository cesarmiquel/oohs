     1                                  org 0x100
     2                                  
     3                                  %define targetFPS 35
     4                                  %define tempo 1193182/1/targetFPS	
     5                                  
     6                                  x2        equ   0x900
     7                                  incx      equ   0x902
     8                                  count     equ   0x903
     9                                  
    10                                  initial_time    equ 0xffc0
    11                                  final_time      equ 0x86
    12                                  
    13                                  init:
    14                                  
    15                                    ; setup gfx
    16 00000000 B013                    	mov al, 0x13
    17 00000002 CD10                    	int 0x10
    18 00000004 95                      	xchg bp, ax
    19 00000005 68F69F                  	push 0xa000-10
    20 00000008 07                      	pop es
    21                                  
    22                                    ; setup dos timer
    23 00000009 B81C25                    mov ax, 0x251c
    24 0000000C BA[A100]                	mov dx, timer
    25 0000000F CD21                    	int 0x21
    26                                  
    27                                  top:
    28 00000011 B8CDCC                  	mov ax, 0xcccd
    29 00000014 F7E7                    	mul di  ; dh: y coord, dl: x coord + carry
    30                                  
    31 00000016 C606[8C00]00              mov byte [palidx+2], 0
    32                                  
    33 0000001B C0EE05                    shr dh, 5 ; row - y/32
    34 0000001E 80EE02                    sub dh, 2 ; row - 2
    35                                  
    36                                    ; 0 <= row < 3
    37 00000021 7C64                      jl blit
    38 00000023 80FE02                    cmp dh, 2
    39 00000026 7F5F                      jg blit
    40                                  
    41                                    ; load si with pointer to font row
    42 00000028 BE[B300]                  mov si, fptext
    43 0000002B 31C0                      xor ax, ax
    44 0000002D 88F0                      mov al, dh
    45 0000002F 69C00600                  mul ax, 6   ; row * 6
    46 00000033 01C6                      add si, ax
    47                                  
    48                                    ; save x and init x2
    49 00000035 88D0                      mov al, dl
    50 00000037 98                        cbw
    51 00000038 A30009                    mov word [x2], ax
    52 0000003B C0FA03                    sar dl, 3
    53 0000003E 88160209                  mov byte [incx], dl
    54 00000042 C606030901                mov byte [count], 1
    55                                  
    56                                  loop:
    57 00000047 A10009                    mov ax, word [x2]
    58                                    ;cbw ; convert 8-bit negative to 16-bit negative (ax)
    59 0000004A 89EA                      mov dx, bp
    60 0000004C 29D0                      sub ax, dx
    61 0000004E 3D0000                    cmp ax, 0
    62                                  
    63 00000051 7C21                      jl skip
    64                                  
    65 00000053 C1E805                    shr ax, 5  ; ofx = (x2-x1)/32
    66 00000056 50                        push ax
    67 00000057 C1E803                    shr ax, 3  ; pos = ofx/8
    68 0000005A 3C05                      cmp al, 5
    69 0000005C 7F29                      jg  blit
    70                                  
    71                                    ;  TODO: usar bx para despues hacer [si + bx]
    72 0000005E 93                        xchg bx, ax
    73                                  
    74 0000005F 30E4                      xor ah, ah
    75 00000061 8A00                      mov al, byte [si+bx]
    76 00000063 59                        pop cx
    77 00000064 81E10700                  and cx, 0x0007
    78 00000068 D2E0                      shl al, cl
    79 0000006A 7308                      jnc skip
    80                                  
    81 0000006C 8A0E0309                  mov cl, byte [count]
    82 00000070 080E[8C00]                or byte [palidx+2], cl
    83                                  
    84                                  skip:
    85 00000074 A00209                    mov al, byte [incx]
    86 00000077 98                        cbw
    87 00000078 01060009                  add word [x2], ax
    88                                  
    89 0000007C D0260309                  shl [count], 1
    90 00000080 803E030910                cmp [count], 0x10
    91 00000085 75C0                      jne loop
    92                                  
    93                                  blit:
    94 00000087 BE[A300]                  mov si, palette
    95                                  palidx:
    96 0000008A 83C602                    add si, byte 0x2
    97 0000008D AC                        lodsb
    98 0000008E AA                      	stosb
    99 0000008F 47                      	inc di
   100 00000090 47                      	inc di
   101 00000091 0F857CFF                  jnz top
   102 00000095 B02A                      mov al, tempo
   102          ******************       warning: byte exceeds bounds [-w+number-overflow]
   103 00000097 E640                    	out 40h, al
   104 00000099 E460                    	in al, 0x60
   105 0000009B FEC8                    	dec al
   106 0000009D 0F8570FF                	jnz top
   107                                  
   108                                  
