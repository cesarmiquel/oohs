     1                                  org 0x100
     2                                  
     3                                  %define tempo 10
     4                                  
     5                                  x2        equ   0x900
     6                                  incx      equ   0x902
     7                                  count     equ   0x903
     8                                  
     9                                  initial_time    equ 0xffc0
    10                                  final_time      equ 0x86
