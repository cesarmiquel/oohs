   199                                  
   200                                  palette:
   201                                    ;db 0, 124, 2, 50
   202                                    ;db 4, 25, 116, 71
   203                                    ;db 34, 79, 79, 76
   204                                    ;db 36, 60, 84, 15
   205                                  
   206 000000D0 00                        db 0
   207 000000D1 03                        db 3   ; l0
   208 000000D2 7C                        db 124 ; l1
   209 000000D3 34                        db 52  ; l0+l1
   210                                  
   211 000000D4 04                        db 4   ; l2
   212 000000D5 34                        db 52  ; l0+l2
   213 000000D6 1B                        db 27  ; l1+l2
   214 000000D7 64                        db 100 ; l0+l1+l2
   215                                  
   216 000000D8 6C                        db 108 ; l3
   217 000000D9 38                        db 56  ; l0+l3
   218 000000DA 4F                        db 79  ; l1+l3
   219 000000DB 4C                        db 76 ; l0+l1+l3
   220                                  
   221 000000DC 26                        db 38  ; l2+l3
   222 000000DD 3C                        db 60  ; l0+l2+l3
   223 000000DE 54                        db 84  ; l1+l2+l3
   224 000000DF 0F                        db 15  ; l0+l1+l2+l3
   225                                  
   226                                  
   227                                  fptext:  ; pixel column k of each byte is bit k
   228 000000E0 2E6E0AEEEE0A              db 0x2e, 0x6e, 0x0a, 0xee, 0xee, 0x0a
   229 000000E6 26EE0EEE460E              db 0x26, 0xee, 0x0e, 0xee, 0x46, 0x0e
   230 000000EC E2CA0AA24A04              db 0xe2, 0xca, 0x0a, 0xa2, 0x4a, 0x04
   231                                  
   232                                  ;fptext:
   233                                  ;  db 0xe8, 0xec, 0xa0, 0xee, 0xee, 0xa0
   234                                  ;  db 0xc8, 0xee, 0xe0, 0xee, 0xc4, 0xe0
   235                                  ;  db 0x8e, 0xa6, 0xa0, 0x8a, 0xa4, 0x40
   236                                  
   237                                  %ifdef MUSIC
   238                                  music:
   239                                    ; synth channel
   240 000000F2 C0                        db 0xc0  ; change instrument on channel 3
   241                                    ;db 52/53    ; Weird voice like effect. Instrument: https://en.wikipedia.org/wiki/General_MIDI#Sound_Effects
   242                                    ; violin: db 41    ; Instrument: https://en.wikipedia.org/wiki/General_MIDI#Sound_Effects
   243 000000F3 35                        db 53    ; Instrument: https://en.wikipedia.org/wiki/General_MIDI#Sound_Effects
   244 000000F4 90                        db 0x90  ; play note on channel 10
   245 000000F5 37                        db 55    ; note number 45
   246 000000F6 7F                        db 127   ; set volume to 127 but it will be gated
   247                                  
   248                                    ; Drum channel / K.O.II
   249 000000F7 99                        db 0x99   ; play note on channel 10 (drums)
   250 000000F8 28                        db 40
   251 000000F9 6E                        db 110    ; play with volume = 127
   252 000000FA 99                        db 0x99   ; play note on channel 10 (drums)
   253 000000FB 3E                        db 62
   254 000000FC 50                        db 80    ; play with volume = 127
   255                                  
   256                                  pattern:
   257 000000FD 98                        db 0b10011000 ; pattern 1
   258 000000FE 6C                        db 0b01101100 ; pattern 2
   259                                  %endif
