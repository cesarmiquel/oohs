    35                                    ;cmp dh, 64
    36                                    ;je draw
    37                                    ;cmp dh, 64+32
    38                                    ;je draw
    39                                    ;cmp dh, 64+32*2
    40                                    ;je draw
    41                                    ;cmp dh, 64+32*3+1
    42                                    ;ja blit2
    43                                  
    44                                    ; draw only lines in 0x40, 0x60, 0x80
    45 0000001E 88F0                      mov al, dh         ; 2 bytes
    46 00000020 3CA1                      cmp al, 64+32*3+1
    47 00000022 7775                      ja blit
    48 00000024 C0C003                    rol al, 3          ; 3 bytes  40h->02h, 60h->03h, 80h->04h
    49 00000027 2C02                      sub al, 2          ; 2 bytes  -> 0, 1, 2
    50 00000029 3C02                      cmp al, 2          ; 2 bytes
    51 0000002B 760F                      jbe draw           ; 2 bytes  unsigned: AL <= 2
    52                                  
    53 0000002D 89FE                      mov si, di
    54 0000002F 81EE4001                  sub si, 320
    55 00000033 B94001                    mov cx, 320
    56 00000036 FC                        cld
    57 00000037 26F3A4                    es rep movsb
    58 0000003A EBD8                      jmp short top
    59                                  
    60                                  draw:
    61 0000003C C0EE05                    shr dh, 5 ; row - y/32
    62 0000003F 80EE02                    sub dh, 2 ; row - 2
    63                                  
    64                                    ; 0 <= row < 3
    65 00000042 7C55                      jl blit
    66 00000044 80FE02                    cmp dh, 2
    67 00000047 7F50                      jg blit
    68                                  
    69                                    ; load si with pointer to font row
    70 00000049 BE[E300]                  mov si, fptext
    71 0000004C 31C0                      xor ax, ax
    72 0000004E 88F0                      mov al, dh
    73 00000050 69C00600                  mul ax, 6   ; row * 6
    74 00000054 01C6                      add si, ax
    75                                  
    76                                    ; save x and init x2
    77 00000056 88D0                      mov al, dl
    78 00000058 98                        cbw ; convert 8-bit negative to 16-bit negative (ax)
    79 00000059 A30009                    mov word [x2], ax
    80 0000005C C0FA03                    sar dl, 3  ; shift right and preserve sign
    81 0000005F 88160209                  mov byte [incx], dl
    82                                  
    83 00000063 B201                      mov dl, 1
    84                                  
    85                                  loop:
    86 00000065 A10009                    mov ax, word [x2]
    87 00000068 29E8                      sub ax, bp
    88                                    ;sub ax, -80
    89 0000006A 7C1E                      jl .skip
    90                                  
    91 0000006C C1E805                    shr ax, 5  ; ofx = (x2-x1)/32
    92 0000006F 89C1                      mov cx, ax
    93 00000071 C1E803                    shr ax, 3  ; pos = ofx/8
    94 00000074 3C05                      cmp al, 5
    95 00000076 7F3A                      jg restart
    96                                  
    97 00000078 93                        xchg bx, ax
    98                                  
    99 00000079 30E4                      xor ah, ah
   100 0000007B 8A00                      mov al, byte [si+bx]
   101 0000007D 80E107                    and cl, 0x07
   102 00000080 D2E0                      shl al, cl
   103 00000082 7306                      jnc .skip
   104                                  
   105 00000084 88D1                      mov cl, dl
   106 00000086 080E[9E00]                or byte [palidx+2], cl
   107                                  
