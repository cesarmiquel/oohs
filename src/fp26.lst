   172                                    ; Music
   173 000000C8 89E9                      mov cx, bp
   174 000000CA 81E10300                  and cx, 0x03
   175 000000CE 7510                      jnz skip_play
   176                                  
   177 000000D0 893E[0701]                mov [music + 3], di
   178                                    ;add [music + 3], 50
   179                                    ;and [music + 3], 0x3f
   180                                  
   181 000000D4 BA3003                    mov dx, 0x330
   182 000000D7 BE[0401]                  mov si, music
   183 000000DA B105                      mov cl, 5
   184 000000DC F36E                      rep  outsb
   185 000000DE 42                        inc dx
   186 000000DF 6E                        outsb
