   199                                    ;db 0, 124, 2, 50
   200                                    ;db 4, 25, 116, 71
   201                                    ;db 34, 79, 79, 76
   202                                    ;db 36, 60, 84, 15
   203                                  
   204 000000C9 00                        db 0
   205 000000CA 03                        db 3   ; l0
   206 000000CB 7C                        db 124 ; l1
   207 000000CC 34                        db 52  ; l0+l1
   208                                  
   209 000000CD 04                        db 4   ; l2
   210 000000CE 34                        db 52  ; l0+l2
   211 000000CF 1B                        db 27  ; l1+l2
   212 000000D0 64                        db 100 ; l0+l1+l2
   213                                  
   214 000000D1 6C                        db 108 ; l3
   215 000000D2 38                        db 56  ; l0+l3
   216 000000D3 4F                        db 79  ; l1+l3
   217 000000D4 4C                        db 76 ; l0+l1+l3
   218                                  
   219 000000D5 26                        db 38  ; l2+l3
   220 000000D6 3C                        db 60  ; l0+l2+l3
