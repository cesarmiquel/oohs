   109 0000008A A00209                    mov al, byte [incx]
   110 0000008D 98                        cbw
   111 0000008E 01060009                  add word [x2], ax
   112                                  
   113 00000092 D0E2                      shl dl, 1
   114 00000094 80FA10                    cmp dl, 0x10
