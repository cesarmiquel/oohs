    26                                  
    27                                  top:
    28 00000011 B8CDCC                  	mov ax, 0xcccd
    29 00000014 F7E7                    	mul di  ; dh: y coord, dl: x coord + carry
    30                                  
    31 00000016 C606[8C00]00              mov byte [palidx+2], 0
    32                                  
    33 0000001B C0EE05                    shr dh, 5 ; row - y/32
    34 0000001E 80EE02                    sub dh, 2 ; row - 2
    35                                  
    36                                    ; 0 <= row < 3
    37 00000021 7C64                      jl blit
    38 00000023 80FE02                    cmp dh, 2
    39 00000026 7F5F                      jg blit
    40                                  
    41                                    ; load si with pointer to font row
    42 00000028 BE[B300]                  mov si, fptext
    43 0000002B 31C0                      xor ax, ax
    44 0000002D 88F0                      mov al, dh
    45 0000002F 69C00600                  mul ax, 6   ; row * 6
    46 00000033 01C6                      add si, ax
    47                                  
    48                                    ; save x and init x2
    49 00000035 88D0                      mov al, dl
    50 00000037 98                        cbw
    51 00000038 A3[C500]                  mov word [x2], ax
    52 0000003B C0FA03                    sar dl, 3
    53 0000003E 8816[C700]                mov byte [incx], dl
    54 00000042 C606[C800]01              mov byte [count], 1
    55                                  
    56                                  loop:
    57 00000047 A1[C500]                  mov ax, word [x2]
    58                                    ;cbw ; convert 8-bit negative to 16-bit negative (ax)
    59 0000004A 89EA                      mov dx, bp
    60                                    ;mov dx, -32*2
    61 0000004C 29D0                      sub ax, dx
    62 0000004E 3D0000                    cmp ax, 0
    63                                  
    64 00000051 7C21                      jl skip
    65                                  
    66 00000053 C1E805                    shr ax, 5  ; ofx = (x2-x1)/32
    67 00000056 50                        push ax
    68 00000057 C1E803                    shr ax, 3  ; pos = ofx/8
    69 0000005A 3C05                      cmp al, 5
    70 0000005C 7F29                      jg  blit
    71                                  
    72                                    ;  TODO: usar bx para despues hacer [si + bx]
    73 0000005E 93                        xchg bx, ax
    74                                  
    75 0000005F 30E4                      xor ah, ah
    76 00000061 8A00                      mov al, byte [si+bx]
    77 00000063 59                        pop cx
    78 00000064 81E10700                  and cx, 0x0007
    79 00000068 D2E0                      shl al, cl
    80 0000006A 7308                      jnc skip
    81                                  
    82 0000006C 8A0E[C800]                mov cl, byte [count]
    83 00000070 080E[8C00]                or byte [palidx+2], cl
    84                                  
    85                                  skip:
    86 00000074 A0[C700]                  mov al, byte [incx]
    87 00000077 98                        cbw
    88 00000078 0106[C500]                add word [x2], ax
    89                                  
    90 0000007C D026[C800]                shl [count], 1
    91 00000080 803E[C800]10              cmp [count], 0x10
    92 00000085 75C0                      jne loop
    93                                  
    94                                  blit:
    95 00000087 BE[A300]                  mov si, palette
    96                                  palidx:
    97 0000008A 83C602                    add si, byte 0x2
    98 0000008D AC                        lodsb
    99 0000008E AA                      	stosb
   100 0000008F 47                      	inc di
   101 00000090 47                      	inc di
   102 00000091 0F857CFF                  jnz top
   103 00000095 B02A                      mov al, tempo
