   234 00000104 C0                        db 0xc0  ; change instrument on channel 3
   235 00000105 59                        db 89    ; Instrument: https://en.wikipedia.org/wiki/General_MIDI#Sound_Effects
   236 00000106 90                        db 0x90   ; play note on channel 10
   237 00000107 23                        db 35   ; deep "b" = note number 35
   238 00000108 7F                        db 127    ; play with volume = 127
