    44                                    ;mov cx, 10
    45                                    ;cld
    46                                    ;es rep movsb
    47                                    ;jmp top
    48                                  
    49                                  draw:
    50 0000001B C0EE05                    shr dh, 5 ; row - y/32
    51 0000001E 80EE02                    sub dh, 2 ; row - 2
    52                                  
    53                                    ; 0 <= row < 3
    54 00000021 7C5F                      jl blit
    55 00000023 80FE02                    cmp dh, 2
    56 00000026 7F5A                      jg blit
    57                                  
    58                                    ; load si with pointer to font row
    59 00000028 BE[BD00]                  mov si, fptext
    60 0000002B 31C0                      xor ax, ax
    61 0000002D 88F0                      mov al, dh
    62 0000002F 69C00600                  mul ax, 6   ; row * 6
    63 00000033 01C6                      add si, ax
    64                                  
    65                                    ; save x and init x2
    66 00000035 88D0                      mov al, dl
    67 00000037 98                        cbw ; convert 8-bit negative to 16-bit negative (ax)
    68 00000038 A30009                    mov word [x2], ax
    69 0000003B C0FA03                    sar dl, 3  ; shift right and preserve sign
    70 0000003E 88160209                  mov byte [incx], dl
    71 00000042 C606030901                mov byte [count], 1
    72                                  
    73                                  loop:
    74 00000047 A10009                    mov ax, word [x2]
    75 0000004A 29E8                      sub ax, bp
    76 0000004C 7C21                      jl skip
    77                                  
    78 0000004E C1E805                    shr ax, 5  ; ofx = (x2-x1)/32
    79 00000051 89C1                      mov cx, ax
    80 00000053 C1E803                    shr ax, 3  ; pos = ofx/8
    81 00000056 3C05                      cmp al, 5
    82 00000058 7F50                      jg restart
    83                                  
    84 0000005A 93                        xchg bx, ax
    85                                  
    86 0000005B 30E4                      xor ah, ah
    87 0000005D 8A00                      mov al, byte [si+bx]
    88 0000005F 81E10700                  and cx, 0x0007
    89 00000063 D2E0                      shl al, cl
    90 00000065 7308                      jnc skip
    91                                  
    92 00000067 8A0E0309                  mov cl, byte [count]
    93 0000006B 080E[8700]                or byte [palidx+2], cl
    94                                  
    95                                  skip:
    96 0000006F A00209                    mov al, byte [incx]
    97 00000072 98                        cbw
    98 00000073 01060009                  add word [x2], ax
    99                                  
   100 00000077 D0260309                  shl [count], 1
   101 0000007B 803E030910                cmp [count], 0x10
   102 00000080 75C5                      jne loop
   103                                  
   104                                  blit:
   105 00000082 BE[AD00]                  mov si, palette
   106                                  palidx:
   107 00000085 83C602                    add si, byte 0x2
   108 00000088 AC                        lodsb
   109                                  blit2:
   110 00000089 AA                      	stosb
   111 0000008A 47                      	inc di
   112 0000008B 47                      	inc di
   113 0000008C 7583                      jnz top
   114 0000008E 81ED0500                  sub bp, 5
   115                                    ;dec bp
   116                                    ;dec bp
   117                                    ;dec bp
   118                                   
   119                                  ; - stabilizes image a bit
   120 00000092 BADA03                    mov dx, 3DAh
   121                                  .wait_start:
   122 00000095 EC                        in al, dx
   123 00000096 A808                      test al, 8
   124 00000098 74FB                      jz .wait_start     ; wait for new retrace to begin
   125                                  
   126 0000009A 0F8573FF                  jnz top
   127                                  
   128 0000009E B00A                      mov al, tempo
   129 000000A0 E640                    	out 40h, al
